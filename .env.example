# Copy to .env and adjust: `cp .env.example .env`
# docker compose reads .env automatically from this folder.

# Host port bindings for the two containers.
# Prefix with 127.0.0.1: (e.g. 127.0.0.1:9550) so they are only reachable
# through nginx on the same host and nobody can bypass the proxy's auth.
APP_PORT=9550
DRAWIO_PORT=8080

# URL the *browser* uses to load draw.io inside /tools/draw.
#   Direct port (no proxy):  http://<server-ip-or-name>:8080/?embed=1&ui=atlas&spin=1&proto=json
#   Behind nginx (/drawio/): /drawio/?embed=1&ui=atlas&spin=1&proto=json
DRAW_IO_URL=http://localhost:8080/?embed=1&ui=atlas&spin=1&proto=json
